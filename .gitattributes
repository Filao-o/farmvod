# Fins de ligne : les lanceurs Windows DOIVENT être en CRLF (cmd.exe gère mal
# les labels/goto en LF), le lanceur macOS en LF (sinon le shebang casse).
* text=auto
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf

*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
